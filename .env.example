# ─── Site ────────────────────────────────────────────────────────────────────
# Public origin used for canonical URLs, Open Graph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional scheduling link (Calendly, Cal.com, HubSpot Meetings…).
# When empty, "Book a strategy call" buttons scroll to the enquiry form.
NEXT_PUBLIC_BOOKING_URL=

# ─── Lead capture: configure at least one destination ────────────────────────
# Option A: webhook (Zapier, Make, n8n, HubSpot workflow, your own API).
# Receives a JSON POST: { type, source, submittedAt, page, lead: {...} }
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header.
LEAD_WEBHOOK_SECRET=

# Option B: email via Resend (https://resend.com). All three are required.
RESEND_API_KEY=
# Comma-separated list of recipients.
LEAD_EMAIL_TO=
# Must be a sender on a domain verified in Resend, e.g. "Website <enquiries@yourdomain.com>".
LEAD_EMAIL_FROM=
